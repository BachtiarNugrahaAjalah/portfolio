# ==============================================================================
# .gitignore - Portofolio Bachtiar Nugraha
# Dikonfigurasi untuk keamanan, kebersihan repository, dan deployment GitHub Pages
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Keamanan, Rahasia & Kredensial Lingkungan (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.token
tokens.json
secrets.*

# ------------------------------------------------------------------------------
# 2. File & Metadata Sistem Operasi
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 3. Node.js, Paket & Log Runtime
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.pnpm-store/
.cache/
package-lock.json.backup

# ------------------------------------------------------------------------------
# 4. Python (Skrip Sinkronisasi GitHub & Konversi WebP)
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 5. Editor & IDE (Pengaturan Pribadi)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ------------------------------------------------------------------------------
# 6. File Mentah Desain Grafis (Cegah Bloat Repo, Format WebP Tetap Terlacak)
# ------------------------------------------------------------------------------
*.psd
*.ai
*.fig
*.sketch
*.xd
*.raw

# ------------------------------------------------------------------------------
# 7. File Uji Coba, Log & Direktori Sementara
# ------------------------------------------------------------------------------
*.log
tmp/
temp/
.temp/
scratch/
test-output/
coverage/

# ------------------------------------------------------------------------------
# 8. AI Agent & Assistant Local Cache
# ------------------------------------------------------------------------------
.agents/
.gemini/
.claude/
.cursor/
.windsurf/

design-system.md
DESIGN.md
PRD.md
portofolio-data.md